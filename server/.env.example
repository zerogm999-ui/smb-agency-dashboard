# ==========================================
# SMB Agency Dashboard - Environment Config
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Server ----
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ---- Database (required) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smb_dashboard
DB_USER=postgres
DB_PASSWORD=postgres
# OR use a connection string (overrides above):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smb_dashboard

# ---- JWT (required) ----
JWT_SECRET=CHANGE_ME_to_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- Google Ads API (optional) ----
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# ---- Meta / Facebook Ads API (optional) ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5001/api/auth/meta/callback

# ---- Stripe API (optional) ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- HubSpot API (optional) ----
HUBSPOT_API_KEY=
HUBSPOT_APP_ID=
HUBSPOT_APP_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:5001/api/auth/hubspot/callback

# ---- Email / SMTP (optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
